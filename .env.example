REDDIT_USER_AGENT=reddit-reposter/1.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel
STATE_DB=data/state.sqlite3
HTTP_CACHE_DB=data/http-cache.sqlite3
SIGNAL_ADMIN_TOKEN=
SIGNAL_PUBLIC_URL=http://127.0.0.1:8765
SIGNAL_BIND_IP=127.0.0.1
SIGNAL_PORT=8765
WEB_WORKERS=2
WEB_THREADS=4
LOG_LEVEL=INFO
SIGNAL_READY_MAX_AGE=7200
SIGNAL_DATA_VOLUME=reddit-reposter_signal-data
# Optional HTTPS proxy (compose.https.yaml): domain without scheme or path.
SIGNAL_DOMAIN=localhost
# Set an immutable release tag when deploying a tagged build.
SIGNAL_IMAGE=reddit-reposter:local
# Published image used with compose.release.yaml; pin a version or sha tag for releases.
SIGNAL_RELEASE_IMAGE=ghcr.io/mr8bit/signal-foundry:latest
# Optional GitHub token without scopes for attention lookups (stars growth of linked repositories).
GITHUB_TOKEN=
